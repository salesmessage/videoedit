C4Component
    title videoedit — Level 3: Components of the CLI container

    UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")

    Person(producer, "Lesson producer", "Runs the CLI")

    Container_Boundary(cli, "videoedit CLI (Node.js)") {
        Component(entry, "CLI & inbox", "index.mjs", "Flags, pending takes, watcher")
        Component(orch, "Take orchestrator", "run.mjs", "Runs the stages in order")
        Component(config, "Config resolver", "lib/config.mjs", "Defaults, sidecar, then flags")
        Component(rules, "House rules", "lib/rules.mjs", "Checked before the encode")
        Component(letterbox, "Letterbox trim", "stages/letterbox.mjs", "Bars off before measuring")
        Component(analyse, "Analyse", "stages/analyse.mjs", "Speech, motion, blanks, text")
        Component(lists, "List detector", "lib/lists.mjs", "Enumerations, narrowly")
        Component(narrate, "Narrate", "stages/narrate.mjs", "Re-voices on the old marks")
        Component(plan, "Plan", "stages/plan.mjs", "Cuts, time map, zoom regions")
        Component(tighten, "Tighten", "stages/tighten.mjs", "Picture and sound as one")
        Component(render, "Render", "stages/render.mjs", "One loop, one timeline")
        Component(sound, "Sound", "stages/sound.mjs", "Clean, level, cues, bed, mux")
        Component(ffgw, "FFmpeg gateway", "lib/ffmpeg.mjs", "The only spawn point")
        Component(ttsc, "TTS client", "lib/tts.mjs", "Provider and content cache")
        Component(paths, "Paths & env", "lib/paths.mjs", "Where things live, and .env")
    }

    ContainerDb(inbox, "in/", "Filesystem", "Takes and sidecars")
    ContainerDb(work, ".work/", "Filesystem", "Transcript, plan report")
    ContainerDb(outbox, "out/", "Filesystem", "Finished lessons")
    ContainerDb(cache, ".cache/tts", "Filesystem", "Rendered speech")
    System_Ext(ffmpeg, "FFmpeg", "Local binary")
    System_Ext(ttsapi, "ElevenLabs / OpenAI", "HTTPS")

    Rel(producer, entry, "npm start", "terminal")
    Rel(entry, inbox, "What is pending", "read")
    Rel(entry, orch, "One take", "processTake()")
    Rel(orch, config, "Config and copy", "")
    Rel(config, inbox, "The sidecar", "read")
    Rel(orch, letterbox, "1. Bars first", "")
    Rel(orch, analyse, "2. Measure the take", "")
    Rel(analyse, work, "Transcript", "write")
    Rel(orch, narrate, "3. --narrate only", "")
    Rel(narrate, ttsc, "Each fixed line", "")
    Rel(ttsc, cache, "Look up, store", "read/write")
    Rel(ttsc, ttsapi, "Render", "HTTPS")
    Rel(orch, lists, "4. Draft and merge", "")
    Rel(orch, plan, "5. Cuts and zooms", "")
    Rel(orch, rules, "6. Hold to the rules", "")
    Rel(rules, work, "Verdicts", "write")
    Rel(orch, tighten, "7. Cut", "")
    Rel(orch, render, "8. Paint", "")
    Rel(orch, sound, "9. Mix and mux", "")
    Rel(sound, outbox, "The lesson", "write")
    Rel(letterbox, ffgw, "spawn", "")
    Rel(analyse, ffgw, "spawn", "")
    Rel(tighten, ffgw, "spawn", "")
    Rel(render, ffgw, "Raw RGBA", "stdin")
    Rel(sound, ffgw, "spawn", "")
    Rel(ffgw, ffmpeg, "stdio pipes", "spawn")
