# Copy to .env and fill in. .env is gitignored; a shell export always wins.
#
# Only needed for --narrate (replacing the narration with text to speech).

# ElevenLabs API key: dashboard -> profile icon -> API Keys
ELEVENLABS_API_KEY=

# Voice ID, not the voice *name*. Dashboard -> Voices -> pick one -> "ID".
# Leave blank for the default ("Rachel", 21m00Tcm4TlvDq8ikWAM).
DEMO_TTS_VOICE=

# Which provider. Optional — inferred from whichever key is set.
# DEMO_TTS=elevenlabs

# OPENAI_API_KEY=

# ---- optional: point the layout elsewhere ----
# VIDEOEDIT_IN=/path/to/inbox
# VIDEOEDIT_OUT=/path/to/outbox
# VIDEOEDIT_BRAND=/path/to/another-brand
